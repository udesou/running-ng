opam-version: "2.0"
synopsis: "opam-monorepo generated lockfile"
maintainer: "opam-monorepo"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "cmdliner" {= "2.1.1+dune" & ?vendor}
  "conf-cmake" {= "1"}
  "conf-libffi" {= "2.0.0"}
  "conf-pkg-config" {= "5"}
  "conf-zlib" {= "1"}
  "csexp" {= "1.5.2" & ?vendor}
  "ctypes" {= "0.24.0" & ?vendor}
  "ctypes-foreign" {= "0.24.0" & ?vendor}
  "dune" {= "3.22.2"}
  "dune-configurator" {= "3.22.2" & ?vendor}
  "hdr_histogram" {= "0.0.6" & ?vendor}
  "integers" {= "0.8.0" & ?vendor}
  "mtime" {= "2.2.0+dune" & ?vendor}
  "ocaml" {= "5.4.1"}
  "ocaml-base-compiler" {= "5.4.1"}
  "ocaml-compiler" {= "5.4.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "stdlib-shims" {= "0.3.0" & ?vendor}
  "trace" {= "0.12" & ?vendor}
  "trace-fuchsia" {= "0.12" & ?vendor}
]
depexts: [
  ["cmake"] {os-distribution = "alpine"}
  ["cmake"] {os-distribution = "arch"}
  ["cmake"] {os-distribution = "cygwin"}
  ["cmake"] {os-distribution = "nixos"}
  ["cmake"] {os-distribution = "ol"}
  ["cmake"] {os-family = "debian"}
  ["cmake"] {os-family = "fedora"}
  ["cmake"] {os-family = "ubuntu"}
  ["cmake"] {os-distribution = "homebrew" & os = "macos"}
  ["cmake"] {os-distribution = "macports" & os = "macos"}
  ["cmake"] {os-family = "suse" | os-family = "opensuse"}
  ["cmake3" "epel-release"] {os-distribution = "centos"}
  ["dev-util/cmake"] {os-distribution = "gentoo"}
  ["devel/cmake"] {os = "dragonfly"}
  ["devel/cmake"] {os = "freebsd"}
  ["devel/cmake"] {os = "netbsd"}
  ["devel/cmake"] {os = "openbsd"}
  ["libffi"] {os = "freebsd"}
  ["libffi"] {os-distribution = "nixos"}
  ["libffi"] {os = "macos" & os-distribution = "homebrew"}
  ["libffi"] {os = "macos" & os-distribution = "macports"}
  ["libffi"] {os = "win32" & os-distribution = "cygwinports"}
  ["libffi-dev"] {os-distribution = "alpine"}
  ["libffi-dev"] {os-family = "debian"}
  ["libffi-dev"] {os-family = "ubuntu"}
  ["libffi-devel"] {os-distribution = "centos"}
  ["libffi-devel"] {os-distribution = "mageia"}
  ["libffi-devel"] {os-distribution = "ol"}
  ["libffi-devel"] {os-family = "fedora"}
  ["libffi-devel"] {os-family = "suse" | os-family = "opensuse"}
  ["pkg-config"] {os-distribution = "nixos"}
  ["pkg-config"] {os-family = "debian" | os-family = "ubuntu"}
  ["pkgconf"] {os = "freebsd"}
  ["pkgconf"] {os-distribution = "alpine"}
  ["pkgconf"] {os-distribution = "arch"}
  ["pkgconf"] {os-distribution = "cygwin"}
  ["pkgconf"] {os = "macos" & os-distribution = "homebrew"}
  ["pkgconf-pkg-config"] {os-distribution = "mageia"}
  ["pkgconf-pkg-config"] {os-family = "fedora"}
  ["pkgconf-pkg-config"] {os-distribution = "centos" & os-version >= "8"}
  ["pkgconf-pkg-config"] {os-distribution = "ol" & os-version >= "8"}
  ["pkgconf-pkg-config"] {os-distribution = "rhel" & os-version >= "8"}
  ["pkgconfig"] {os = "macos" & os-distribution = "macports"}
  ["pkgconfig"] {os-distribution = "centos" & os-version <= "7"}
  ["pkgconfig"] {os-distribution = "ol" & os-version <= "7"}
  ["pkgconfig"] {os-distribution = "rhel" & os-version <= "7"}
  ["system:cmake"] {os-distribution = "cygwinports"}
  ["system:pkgconf"] {os = "win32" & os-distribution = "cygwinports"}
  ["zlib"] {os-distribution = "nixos"}
  ["zlib"] {os-family = "arch"}
  ["zlib"] {os = "win32" & os-distribution = "cygwinports"}
  ["zlib"] {os-distribution = "homebrew" & os = "macos"}
  ["zlib-dev"] {os-distribution = "alpine"}
  ["zlib-devel"] {os = "cygwin"}
  ["zlib-devel"] {os-distribution = "ol"}
  ["zlib-devel"] {os-family = "fedora" & os-version < "40"}
  ["zlib-devel"] {os-family = "suse" & os-version < "16"}
  ["zlib-devel" "zlib-static"]
    {os-distribution = "centos" & os-version < "10"}
  ["zlib-ng-compat-devel"] {os-family = "opensuse"}
  ["zlib-ng-compat-devel"] {os-family = "suse" & os-version >= "16"}
  ["zlib-ng-compat-devel" "zlib-ng-compat-static"]
    {os-distribution = "centos" & os-version >= "10"}
  ["zlib-ng-compat-devel" "zlib-ng-compat-static"]
    {os-family = "fedora" & os-version >= "40"}
  ["zlib1g-dev"] {os-family = "debian"}
  ["zlib1g-dev"] {os-family = "ubuntu"}
]
pin-depends: [
  [
    "cmdliner.2.1.1+dune"
    "https://github.com/dune-universe/cmdliner/releases/download/v2.1.1%2Bdune/cmdliner-2.1.1.dune.tbz"
  ]
