  ]
  [
    "ctypes-foreign.0.24.0"
    "https://github.com/yallop/ocaml-ctypes/archive/refs/tags/0.24.0.tar.gz"
  ]
  [
    "dune-configurator.3.22.2"
    "https://github.com/ocaml/dune/releases/download/3.22.2/dune-3.22.2.tbz"
  ]
  [
    "hdr_histogram.0.0.6"
    "https://github.com/ocaml-multicore/hdr_histogram_ocaml/releases/download/0.0.6/hdr_histogram-0.0.6.tbz"
  ]
  [
    "integers.0.8.0"
    "https://github.com/yallop/ocaml-integers/archive/0.8.0.tar.gz"
  ]
  [
    "mtime.2.2.0+dune"
    "https://github.com/dune-universe/mtime/releases/download/v2.2.0%2Bdune/mtime-2.2.0.dune.tbz"
  ]
  [
    "stdlib-shims.0.3.0"
    "https://github.com/ocaml/stdlib-shims/releases/download/0.3.0/stdlib-shims-0.3.0.tbz"
  ]
  [
    "trace.0.12"
    "https://github.com/ocaml-tracing/ocaml-trace/releases/download/v0.12/trace-0.12.tbz"
  ]
  [
    "trace-fuchsia.0.12"
    "https://github.com/ocaml-tracing/ocaml-trace/releases/download/v0.12/trace-0.12.tbz"
  ]
]
